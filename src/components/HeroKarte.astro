---
/**
 * Stilisierte Thüringen-Karte (Startseite) – vereinfachter Umriss als SVG,
 * Projekte als farbige Punkte nach Nutzungsart. Kein Kartendienst nötig.
 * Punkte sind Links; Hover/Fokus zeigt die Projektvorschau.
 */
import { getImage } from 'astro:assets';
import { url } from '../lib/url';
import type { Projekt } from '../lib/projekte';
import { NUTZUNGSART, NUTZUNGSART_FARBE } from '../lib/taxonomie';

interface Props {
  projekte: Projekt[];
  /** Projekt, das die Vorschau anfangs zeigt */
  start: Projekt;
}
const { projekte, start } = Astro.props;

// Einfache Projektion (Längengrade mit cos(51°) gestaucht)
const LNG0 = 9.8;
const LAT0 = 51.72;
const K = 100;
const COS = Math.cos((51 * Math.PI) / 180);
const proj = ([lat, lng]: [number, number]) => [(lng - LNG0) * COS * K, (LAT0 - lat) * K] as const;

// Vereinfachter, stilisierter Landesumriss (grobe Annäherung, keine exakte Grenze)
const umriss: [number, number][] = [
  [51.64, 10.62], [51.6, 10.98], [51.47, 11.3], [51.38, 11.45], [51.26, 11.72], [51.16, 11.95],
  [51.06, 12.2], [51.12, 12.42], [51.02, 12.65], [50.88, 12.6], [50.76, 12.38], [50.63, 12.27],
  [50.42, 12.05], [50.4, 11.88], [50.46, 11.66], [50.38, 11.52], [50.4, 11.3], [50.3, 11.18],
  [50.26, 10.98], [50.33, 10.75], [50.4, 10.52], [50.5, 10.3], [50.58, 10.05], [50.72, 9.95],
  [50.88, 10.05], [50.98, 9.97], [51.1, 10.12], [51.2, 10.02], [51.33, 9.93], [51.42, 10.12],
  [51.5, 10.35],
];
const pts = umriss.map(proj);
const pfad = `M${pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join('L')}Z`;
const xs = pts.map((p) => p[0]);
const ys = pts.map((p) => p[1]);
const pad = 8;
const viewBox = `${Math.min(...xs) - pad} ${Math.min(...ys) - pad} ${Math.max(...xs) - Math.min(...xs) + 2 * pad} ${Math.max(...ys) - Math.min(...ys) + 2 * pad}`;

const punkte = await Promise.all(
  projekte
    .filter((p) => p.data.koordinaten)
    .map(async (p) => {
      const [x, y] = proj(p.data.koordinaten!);
      return {
        id: p.id,
        x,
        y,
        farbe: NUTZUNGSART_FARBE[p.data.nutzungsart[0] ?? 'Gewerbe'],
        titel: p.data.titel,
        stadt: p.data.stadt,
        bild: p.data.bilder[0] ? (await getImage({ src: p.data.bilder[0].pfad, width: 480, format: 'webp' })).src : '',
      };
    }),
);
const s0 = punkte.find((p) => p.id === start.id) ?? punkte[0];
// Städte beschriften – nur, wo die Beschriftung nicht mit einer anderen kollidiert
const FONT = 6;
const breite = (t: string) => t.length * FONT * 0.55;
const belegt: { x: number; y: number; w: number }[] = [];
const staedte = [...new Map(punkte.map((p) => [p.stadt.replace(/^Stadt (Amt )?/, ''), p])).entries()]
  .sort((a, b) => a[1].x - b[1].x)
  .filter(([name, p]) => {
    const box = { x: p.x + 4, y: p.y - 3, w: breite(name) };
    const frei = belegt.every((b) => box.x > b.x + b.w + 2 || b.x > box.x + box.w + 2 || Math.abs(b.y - box.y) > FONT + 1);
    if (frei) belegt.push(box);
    return frei;
  });
---

<div class="hkarte" data-hkarte>
  <svg class="hkarte__svg" viewBox={viewBox} role="group" aria-label="Stilisierte Karte Thüringens mit den Projekten">
    <path d={pfad} class="hkarte__land"></path>
    {
      staedte.map(([name, p]) => (
        <text x={p.x + 4} y={p.y - 3} class="hkarte__ort" aria-hidden="true">
          {name}
        </text>
      ))
    }
    {
      punkte.map((p) => (
        <a
          href={url(`projekte/${p.id}/`)}
          class:list={['hkarte__punkt', { 'is-active': p.id === s0?.id }]}
          data-punkt={p.id}
          data-titel={p.titel}
          data-stadt={p.stadt}
          data-bild={p.bild}
          aria-label={`${p.stadt}: ${p.titel}`}
        >
          <circle cx={p.x} cy={p.y} r="9" class="hkarte__ziel" />
          <circle cx={p.x} cy={p.y} r="3.6" fill={p.farbe} class="hkarte__dot" />
        </a>
      ))
    }
  </svg>

  {
    s0 && (
      <a class="hkarte__vorschau" href={url(`projekte/${s0.id}/`)} data-vorschau aria-hidden="true" tabindex="-1">
        {s0.bild && <img src={s0.bild} alt="" data-vorschau-bild />}
        <span class="hkarte__vtext">
          <span class="hkarte__vstadt" data-vorschau-stadt>{s0.stadt}</span>
          <span class="hkarte__vtitel" data-vorschau-titel>{s0.titel}</span>
          <span class="hkarte__vlink">Projekt ansehen →</span>
        </span>
      </a>
    )
  }

  <ul class="hkarte__legende" aria-label="Legende Nutzungsart">
    {
      NUTZUNGSART.map((n) => (
        <li>
          <span style={`--dot: ${NUTZUNGSART_FARBE[n]}`} aria-hidden="true" />
          {n}
        </li>
      ))
    }
  </ul>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-hkarte]');
  const vorschau = root?.querySelector<HTMLAnchorElement>('[data-vorschau]');
  if (root && vorschau) {
    const bild = vorschau.querySelector<HTMLImageElement>('[data-vorschau-bild]');
    const show = (a: SVGAElement) => {
      root.querySelectorAll('.hkarte__punkt').forEach((p) => p.classList.toggle('is-active', p === a));
      vorschau.href = a.getAttribute('href')!;
      vorschau.querySelector('[data-vorschau-titel]')!.textContent = a.dataset.titel ?? '';
      vorschau.querySelector('[data-vorschau-stadt]')!.textContent = a.dataset.stadt ?? '';
      if (bild && a.dataset.bild) bild.src = a.dataset.bild;
    };
    root.querySelectorAll<SVGAElement>('[data-punkt]').forEach((a) => {
      a.addEventListener('mouseenter', () => show(a));
      a.addEventListener('focus', () => show(a));
    });
  }
</script>

<style>
  .hkarte {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12.5rem;
    align-items: center;
    gap: var(--space-4);
  }
  .hkarte__svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hkarte__land {
    fill: var(--ink-soft);
    stroke: #3a3e48;
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
  .hkarte__ort {
    fill: var(--on-ink-muted);
    font-size: 6px;
    font-family: var(--font-body);
    pointer-events: none;
  }
  .hkarte__ziel {
    fill: transparent;
  }
  .hkarte__dot {
    stroke: var(--ink);
    stroke-width: 1.2;
    transition: r var(--transition);
  }
  .hkarte__punkt:hover .hkarte__dot,
  .hkarte__punkt:focus-visible .hkarte__dot,
  .hkarte__punkt.is-active .hkarte__dot {
    r: 5.5;
    stroke: var(--on-ink);
    stroke-width: 1.6;
  }
  .hkarte__punkt:focus-visible {
    box-shadow: none;
    outline: none;
  }
  .hkarte__punkt:focus-visible .hkarte__ziel {
    stroke: var(--accent-light);
    stroke-width: 1.5;
  }
  .hkarte__vorschau {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    color: var(--ink);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-pop);
    text-decoration: none;
  }
  .hkarte__vorschau img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .hkarte__vtext {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: var(--space-3) var(--space-4) var(--space-4);
    font-size: var(--text-sm);
  }
  .hkarte__vstadt {
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .hkarte__vtitel {
    font-weight: 600;
    line-height: 1.3;
  }
  .hkarte__vlink {
    margin-top: var(--space-1);
    color: var(--accent);
    font-weight: 600;
  }
  .hkarte__legende {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    color: var(--on-ink-muted);
    font-size: var(--text-xs);
  }
  .hkarte__legende li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .hkarte__legende span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--dot);
  }
  @media (max-width: 900px) {
    .hkarte {
      grid-template-columns: 1fr;
    }
    .hkarte__vorschau {
      display: none;
    }
  }
</style>
