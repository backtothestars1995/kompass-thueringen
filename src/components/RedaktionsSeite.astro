---
// Seite mit redaktionellem Markdown-Text aus src/content/seiten/ (Rechtliches)
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  id: string;
  description: string;
}
const { id, description } = Astro.props;
const seite = await getEntry('seiten', id);
if (!seite) throw new Error(`Seite „${id}“ fehlt in src/content/seiten/.`);
const leer = (seite.body ?? '').replace(/<!--[\s\S]*?-->/g, '').trim() === '';
const { Content } = await render(seite);
---

<BaseLayout title={seite.data.titel} description={description}>
  <article class="container seite">
    <span class="eyebrow">Rechtliches</span>
    <h1>{seite.data.titel}</h1>
    <div class="prose">
      {leer ? <p class="placeholder">[Text folgt – wird von der Redaktion geliefert]</p> : <Content />}
    </div>
  </article>
</BaseLayout>

<style>
  .seite {
    padding-block: var(--space-7) var(--section-gap);
  }
  .seite h1 {
    font-size: var(--text-3xl);
  }
</style>
