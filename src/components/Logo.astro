---
// Wortmarke KOMPASS Thüringen (vorläufig bis zur Festlegung der CI)
import { url } from '../lib/url';

interface Props {
  tone?: 'light' | 'dark';
  showRegion?: boolean;
}
const { tone = 'light', showRegion = true } = Astro.props;
---

<a href={url()} class:list={['logo', `logo--${tone}`]} aria-label="KOMPASS Thüringen – zur Startseite">
  <svg class="logo__icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path d="M16 5 L20 16 L12 16 Z" fill="var(--accent)"></path>
    <path d="M16 27 L20 16 L12 16 Z" fill="currentColor"></path>
  </svg>
  <span class="logo__word">KOMPASS</span>
  {showRegion && <span class="logo__region">Thüringen</span>}
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--ink);
  }
  .logo--dark {
    color: var(--on-ink);
  }
  .logo__icon {
    width: 2rem;
    height: 2rem;
    flex: none;
  }
  .logo__word {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: var(--tracking-heading);
  }
  .logo__region {
    font-size: var(--text-sm);
    color: var(--muted);
    margin-left: var(--space-1);
    align-self: flex-end;
    padding-bottom: 0.2rem;
  }
  .logo--dark .logo__region {
    color: var(--on-ink-muted);
  }
</style>
