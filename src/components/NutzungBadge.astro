---
// Nutzungsart-Badge mit Farbpunkt – Farben identisch zu Kartenmarkern und Legende
import { NUTZUNGSART_FARBE, type Nutzungsart } from '../lib/taxonomie';

interface Props {
  nutzungsart: Nutzungsart;
  tone?: 'light' | 'dark' | 'plain';
}
const { nutzungsart, tone = 'light' } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`]}>
  <span class="badge__dot" style={`--dot: ${NUTZUNGSART_FARBE[nutzungsart]}`} aria-hidden="true"></span>
  {nutzungsart}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
  }
  .badge--light {
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 1px 2px rgb(22 24 29 / 0.12);
  }
  .badge--dark {
    background: var(--surface);
    color: var(--ink);
  }
  .badge--plain {
    padding: 0;
    font-weight: 500;
  }
  .badge__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--dot);
    flex: none;
  }
</style>
