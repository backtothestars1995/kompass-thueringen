---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Seite nicht gefunden" description="Diese Seite gibt es leider nicht.">
  <section class="container page-header">
    <span class="eyebrow">Fehler 404</span>
    <h1>Diese Seite gibt es leider nicht.</h1>
    <p class="lead">Vielleicht hilft Ihnen einer dieser Wege weiter:</p>
    <p>
      <a class="btn btn--dark" href={url()}>Zur Startseite</a>
      <a class="btn btn--outline" href={url('entdecken/')}>Projekte entdecken</a>
    </p>
  </section>
</BaseLayout>
