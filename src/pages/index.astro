---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroKarte from '../components/HeroKarte.astro';
import ProjektFinder from '../components/ProjektFinder.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NutzungBadge from '../components/NutzungBadge.astro';
import Ampel from '../components/Ampel.astro';
import { getProjekte, zeitraumText } from '../lib/projekte';
import { getGlossarIndex } from '../lib/glossar';
import { filterDaten } from '../lib/filter-daten';
import { entdeckenLink, type ListenFacette } from '../lib/filter';
import { EINWOHNERZAHL } from '../lib/taxonomie';
import { url } from '../lib/url';
import { getLeitfaeden } from '../lib/leitfaeden';

const base = url();
const projekte = await getProjekte();
const daten = await filterDaten(projekte);
const leitfaeden = await getLeitfaeden();
const glossar = await getGlossarIndex();

// Kennzahlen – automatisch aus dem Datenbestand gezählt
const kennzahlen = [
  { wert: projekte.length, label: 'dokumentierte Projekte' },
  { wert: new Set(projekte.map((p) => p.data.stadt.replace(/^Stadt (Amt )?/, ''))).size, label: 'beteiligte Kommunen' },
  { wert: projekte.filter((p) => p.data.foerderung).length, label: 'davon mit Förderung' },
  { wert: leitfaeden.length, label: 'Praxis-Leitfäden' },
];

// Schnellfilter-Chips (öffnen Entdecken mit gesetztem Filter)
const schnellfilter = [
  { label: 'Zwischennutzung', href: entdeckenLink(base, { projektzweck: ['Zwischennutzung eines leerstehenden Objektes'] }) },
  { label: 'Wohnen', href: entdeckenLink(base, { nutzungsart: ['Wohnen'] }) },
  { label: 'Mit Förderung', href: entdeckenLink(base, { foerderung: ['ja'] }) },
  { label: 'bis 50.000 €', href: entdeckenLink(base, { kosten: [0, 3] }) },
];

// Projekt im Fokus: redaktionell per „im_fokus: true“, sonst das neueste Projekt
const fokus = projekte.find((p) => p.data.im_fokus) ?? projekte[0];
const neueste = projekte.slice(0, 8);

// Begriff des Tages: Begriffe, nach denen sich filtern lässt
const facetteJeKategorie: Record<string, ListenFacette> = {
  Leerstandstyp: 'kategorie',
  Nutzungsart: 'nutzungsart',
  Projektzweck: 'projektzweck',
};
const begriffe = [...glossar.values()]
  .filter((g) => facetteJeKategorie[g.kategorie])
  .map((g) => {
    const facette = facetteJeKategorie[g.kategorie];
    const anzahl = projekte.filter((p) => (p.data[facette] as readonly string[]).includes(g.begriff)).length;
    return { ...g, anzahl, href: entdeckenLink(base, { [facette]: [g.begriff] }) };
  })
  .filter((g) => g.anzahl > 0)
  .sort((a, b) => a.begriff.localeCompare(b.begriff, 'de'));

const leitfadenTon = ['dunkel', 'akzent', 'sand'];
---

<BaseLayout
  title="Startseite"
  description="Der KOMPASS zeigt, wie Thüringer Kommunen leerstehende Gewerbeflächen wieder mit Leben füllen – mit Beispielen, Kennzahlen und Erfahrungen aus der Praxis."
  headerTone="dark"
  footer="full"
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <span class="eyebrow hero__eyebrow">Projektpool für Thüringer Innenstädte</span>
        <h1>Leerstand ist Möglichkeits&shy;raum.</h1>
        <p class="hero__lead">
          Entdecken Sie, wie Thüringer Kommunen leerstehende Gewerbeflächen wieder mit Leben füllen – mit Beispielen,
          Kennzahlen und Erfahrungen aus der Praxis.
        </p>
        <form class="hero__suche" role="search" action={url('entdecken/')} method="get">
          <label for="hero-suche" class="visually-hidden">Ort, Projekt oder Stichwort</label>
          <input id="hero-suche" type="search" name="q" placeholder="Ort, Projekt oder Stichwort …" />
          <button type="submit" class="btn btn--dark">Suchen</button>
        </form>
        <ul class="hero__chips" aria-label="Schnellfilter">
          {
            schnellfilter.map((c) => (
              <li>
                <a href={c.href}>{c.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="hero__karte">
        <HeroKarte projekte={projekte} start={fokus} />
      </div>
    </div>

    <div class="container">
      <dl class="kennzahlen">
        {
          kennzahlen.map((k) => (
            <div>
              <dt>{k.label}</dt>
              <dd data-countup={k.wert}>{k.wert}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Einstieg nach Zielgruppe -->
  <section class="container section" aria-labelledby="einstieg-titel">
    <span class="eyebrow">Ihr Einstieg</span>
    <h2 id="einstieg-titel">Wer sind Sie?</h2>
    <ul class="einstieg">
      <li class="einstieg__karte einstieg__karte--dunkel">
        <span class="einstieg__nr">01</span>
        <h3>Ich arbeite in einer Kommune</h3>
        <p>Lösungswege, Planungsinstrumente und Förderzugänge aus vergleichbaren Städten.</p>
        <form action={url('entdecken/')} method="get" class="einstieg__form">
          <input type="hidden" name="sort" value="einwohner" />
          <label for="einstieg-ew">Einwohnerzahl Ihrer Kommune</label>
          <div class="einstieg__formzeile">
            <select id="einstieg-ew" name="ew">
              {EINWOHNERZAHL.map((e, i) => <option value={i}>{e}</option>)}
            </select>
            <button type="submit" class="einstieg__link">Vorsortiert nach ähnlicher Einwohnerzahl →</button>
          </div>
        </form>
      </li>
      <li class="einstieg__karte">
        <span class="einstieg__nr">02</span>
        <h3>Mich interessiert meine Stadt</h3>
        <p>Sehen, was aus leeren Läden werden kann – Projekte in Ihrer Nähe auf der Karte.</p>
        <a class="einstieg__link" href={entdeckenLink(base, { ansicht: 'karte' })}>Karte in meiner Umgebung öffnen →</a>
      </li>
      <li class="einstieg__karte einstieg__karte--sand">
        <span class="einstieg__nr">03</span>
        <h3>Ich entwickle oder investiere</h3>
        <p>Nachnutzungskonzepte, Kostenrahmen und personellen Aufwand auf einen Blick vergleichen.</p>
        <a class="einstieg__link" href={entdeckenLink(base, { sort: 'kosten-auf' })}>Projekte nach Kosten vergleichen →</a>
      </li>
    </ul>

    <div class="finder-wrap">
      <ProjektFinder daten={daten} />
    </div>
  </section>

  <!-- Projekt im Fokus -->
  {
    fokus && (
      <section class="container" aria-labelledby="fokus-titel">
        <article class="fokus">
          <div class="fokus__bild">
            {fokus.data.bilder[0] && (
              <Image src={fokus.data.bilder[0].pfad} alt={fokus.data.bilder[0].alt} widths={[640, 960, 1280]} sizes="(max-width: 860px) 100vw, 50vw" />
            )}
          </div>
          <div class="fokus__text">
            <span class="eyebrow">Projekt im Fokus</span>
            <h2 id="fokus-titel">{fokus.data.titel}</h2>
            <p class="fokus__stadt">{fokus.data.stadt}</p>
            {fokus.data.projektziel ? (
              <p class="fokus__teaser">{fokus.data.projektziel.replace(/^- /gm, '').split('\n').join(' · ')}</p>
            ) : (
              <p class="placeholder">[Teaser aus dem Projektziel]</p>
            )}
            <ul class="fokus__fakten">
              {fokus.data.nutzungsart[0] && (
                <li>
                  <NutzungBadge nutzungsart={fokus.data.nutzungsart[0]} />
                </li>
              )}
              <li>Zeitraum {zeitraumText(fokus.data.zeitraum)}</li>
              <li>Förderung {fokus.data.foerderung === undefined ? '[keine Angabe]' : fokus.data.foerderung ? 'ja' : 'nein'}</li>
              <li>
                <Ampel wert={fokus.data.personeller_aufwand} prefix="Aufwand" />
              </li>
            </ul>
            <a class="btn btn--light" href={url(`projekte/${fokus.id}/`)}>
              Geschichte lesen →
            </a>
          </div>
        </article>
      </section>
    )
  }

  <!-- Zuletzt hinzugefügt -->
  <section class="container section" aria-labelledby="neu-titel" data-karussell>
    <div class="neu__kopf">
      <div>
        <span class="eyebrow">Neu im Projektpool</span>
        <h2 id="neu-titel">Zuletzt hinzugefügt</h2>
      </div>
      <div class="neu__nav">
        <a class="link-arrow neu__alle" href={url('entdecken/')}>Alle Projekte →</a>
        <button type="button" class="neu__pfeil" data-karussell-prev aria-label="Vorherige Projekte">←</button>
        <button type="button" class="neu__pfeil neu__pfeil--dunkel" data-karussell-next aria-label="Weitere Projekte">→</button>
      </div>
    </div>
    <ul class="neu__liste" data-karussell-liste tabindex="0" aria-label="Zuletzt hinzugefügte Projekte">
      {
        neueste.map((p) => (
          <li>
            <ProjectCard projekt={p} />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Begriff des Tages + Leitfäden -->
  <section class="container wissen-teaser" aria-label="Wissen">
    <div class="begriff" data-begriff-des-tages>
      <span class="eyebrow">Begriff des Tages</span>
      {
        begriffe.map((g, i) => (
          <div class="begriff__eintrag" data-begriff={i} hidden={i !== 0}>
            <h2 class="begriff__titel">{g.begriff}</h2>
            <p class:list={{ placeholder: g.leer }}>{g.text}</p>
            <a class="link-arrow" href={g.href}>
              → {g.anzahl} {g.anzahl === 1 ? 'Projekt' : 'Projekte'} mit diesem {g.kategorie === 'Leerstandstyp' ? 'Leerstandstyp' : g.kategorie === 'Nutzungsart' ? 'Nutzungsart' : 'Projektzweck'}
            </a>
          </div>
        ))
      }
      <a class="begriff__abc" href={url('wissen/#glossar')}>Zum Leerstands-ABC →</a>
    </div>
    <ul class="leitfaeden">
      {
        leitfaeden.map((l, i) => (
          <li class:list={['leitfaden', `leitfaden--${leitfadenTon[i % 3]}`]}>
            <span class="leitfaden__eyebrow">Leitfaden</span>
            <h2 class="leitfaden__titel">
              <a href={url(`wissen/leitfaeden/${l.id}/`)}>{l.data.kurztitel ?? l.data.titel}</a>
            </h2>
            <p class="leitfaden__meta">{l.data.pdf ? 'PDF · online lesen' : 'online lesen'}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Partner -->
  <section class="container section partner" aria-labelledby="partner-titel">
    <div class="partner__kopf">
      <h2 id="partner-titel" class="partner__text">
        Der KOMPASS ist ein Projekt des Thüringer Aktionsbündnisses „Innenstädte mit Zukunft“ – getragen von <span
          class="placeholder">[n]</span
        > Partnern aus Land, Kammern und Verbänden.
      </h2>
      <button type="button" class="btn btn--outline btn--small" data-laufband-toggle aria-pressed="false">
        <span aria-hidden="true" data-laufband-icon>❚❚</span>
        <span data-laufband-label>Anhalten</span>
      </button>
    </div>
    <div class="laufband" data-laufband>
      <ul class="laufband__spur">
        {
          Array.from({ length: 8 }, (_, i) => (
            <li class="laufband__logo">
              <span class="placeholder">[Logo {i + 1}]</span>
            </li>
          ))
        }
      </ul>
      <ul class="laufband__spur" aria-hidden="true">
        {
          Array.from({ length: 8 }, (_, i) => (
            <li class="laufband__logo">
              <span class="placeholder">[Logo {i + 1}]</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  // Kennzahlen hochzählen (nur ohne „Bewegung reduzieren“)
  const reduziert = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduziert) {
    const els = document.querySelectorAll<HTMLElement>('[data-countup]');
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const ziel = Number(el.dataset.countup);
        const start = performance.now();
        const dauer = 900;
        const tick = (t: number) => {
          const f = Math.min(1, (t - start) / dauer);
          el.textContent = String(Math.round(ziel * (1 - Math.pow(1 - f, 3))));
          if (f < 1) requestAnimationFrame(tick);
        };
        el.textContent = '0';
        requestAnimationFrame(tick);
      }
    });
    els.forEach((el) => io.observe(el));
  }

  // Karussell „Zuletzt hinzugefügt“
  const liste = document.querySelector<HTMLElement>('[data-karussell-liste]');
  const schritt = () => (liste?.querySelector('li')?.getBoundingClientRect().width ?? 300) + 20;
  document.querySelector('[data-karussell-prev]')?.addEventListener('click', () =>
    liste?.scrollBy({ left: -schritt(), behavior: reduziert ? 'auto' : 'smooth' }),
  );
  document.querySelector('[data-karussell-next]')?.addEventListener('click', () =>
    liste?.scrollBy({ left: schritt(), behavior: reduziert ? 'auto' : 'smooth' }),
  );

  // Begriff des Tages: wechselt täglich (Tag des Jahres)
  const eintraege = [...document.querySelectorAll<HTMLElement>('[data-begriff]')];
  if (eintraege.length) {
    const heute = new Date();
    const tag = Math.floor((Date.UTC(heute.getFullYear(), heute.getMonth(), heute.getDate()) - Date.UTC(heute.getFullYear(), 0, 0)) / 864e5);
    const wahl = tag % eintraege.length;
    eintraege.forEach((e, i) => (e.hidden = i !== wahl));
  }

  // Laufband mit Pause-Schalter (WCAG 2.2.2)
  const band = document.querySelector<HTMLElement>('[data-laufband]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-laufband-toggle]');
  if (band && toggle) {
    const setPause = (pause: boolean) => {
      band.classList.toggle('is-paused', pause);
      toggle.setAttribute('aria-pressed', String(pause));
      toggle.querySelector('[data-laufband-label]')!.textContent = pause ? 'Abspielen' : 'Anhalten';
      toggle.querySelector('[data-laufband-icon]')!.textContent = pause ? '▶' : '❚❚';
    };
    setPause(reduziert);
    toggle.addEventListener('click', () => setPause(!band.classList.contains('is-paused')));
  }
</script>

<style>
  /* Hero */
  .hero {
    background: var(--ink);
    color: var(--on-ink);
    padding-top: var(--space-7);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: center;
  }
  .hero__eyebrow {
    color: var(--accent-light);
  }
  .hero h1 {
    max-width: 11ch;
  }
  .hero__lead {
    color: var(--on-ink-muted);
    font-size: var(--text-lg);
    max-width: 48ch;
  }
  .hero__suche {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    max-width: 34rem;
    margin-top: var(--space-6);
    padding: 0.3rem 0.3rem 0.3rem var(--space-5);
    background: var(--surface);
    border-radius: var(--radius-full);
  }
  .hero__suche:focus-within {
    box-shadow: 0 0 0 3px var(--accent-light);
  }
  .hero__suche input {
    flex: 1;
    min-width: 0;
    min-height: 2.75rem;
    border: 0;
    background: none;
    color: var(--ink);
  }
  .hero__suche input:focus-visible {
    box-shadow: none;
  }
  .hero__suche input::placeholder {
    color: var(--muted);
  }
  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
  }
  .hero__chips a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 var(--space-4);
    border: 1px solid #4a4e58;
    border-radius: var(--radius-full);
    color: var(--on-ink);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .hero__chips a:hover {
    border-color: var(--on-ink);
  }

  .kennzahlen {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
    margin: var(--space-7) 0 0;
    padding-block: var(--space-6);
    border-top: 1px solid var(--ink-soft);
  }
  .kennzahlen div {
    display: flex;
    flex-direction: column-reverse;
  }
  .kennzahlen dt {
    color: var(--on-ink-muted);
    font-size: var(--text-sm);
  }
  .kennzahlen dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  /* Einstieg */
  .einstieg {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }
  .einstieg__karte {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
  }
  .einstieg__karte--dunkel {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--on-ink);
  }
  .einstieg__karte--sand {
    background: var(--sand);
    border-color: var(--sand);
  }
  .einstieg__nr {
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-5);
  }
  .einstieg__karte--sand .einstieg__nr,
  .einstieg__karte--sand .einstieg__link {
    color: var(--accent-strong);
  }
  .einstieg__karte--dunkel .einstieg__nr,
  .einstieg__karte--dunkel .einstieg__link {
    color: var(--accent-light);
  }
  .einstieg__karte h3 {
    font-size: var(--text-xl);
    font-weight: 700;
    margin-bottom: var(--space-2);
  }
  .einstieg__karte p {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .einstieg__karte--dunkel p,
  .einstieg__karte--dunkel label {
    color: var(--on-ink-muted);
  }
  .einstieg__link {
    margin-top: auto;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 600;
    text-align: left;
    text-decoration: none;
  }
  .einstieg__link:hover {
    text-decoration: underline;
  }
  .einstieg__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: auto;
    font-size: var(--text-sm);
  }
  .einstieg__formzeile {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .einstieg__form select {
    min-height: 2.25rem;
    padding: 0 var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid var(--ink-soft);
    background: var(--ink-soft);
    color: var(--on-ink);
  }
  .finder-wrap {
    margin-top: var(--space-5);
  }

  /* Projekt im Fokus */
  .fokus {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 26rem;
    background: var(--ink);
    color: var(--on-ink);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }
  .fokus__bild img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fokus__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
  }
  .fokus .eyebrow {
    color: var(--accent-light);
  }
  .fokus h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-1);
  }
  .fokus__stadt {
    color: var(--on-ink-muted);
  }
  .fokus__teaser {
    max-width: 52ch;
    color: var(--on-ink);
  }
  .fokus__fakten {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
  }
  .fokus__fakten li {
    display: inline-flex;
    align-items: center;
    min-height: 1.9rem;
    padding: 0 var(--space-3);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .fokus__fakten li:has(.badge) {
    padding: 0;
    background: none;
  }

  /* Zuletzt hinzugefügt */
  .neu__kopf {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .neu__nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .neu__alle {
    margin-right: var(--space-3);
  }
  .neu__pfeil {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    font-size: 1.1rem;
  }
