---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoTip from '../../components/InfoTip.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjekte } from '../../lib/projekte';
import { eckdaten, type EckdatenGruppe } from '../../lib/eckdaten';
import { alsJson } from '../../lib/filter-daten';
import { url } from '../../lib/url';

const projekte = await getProjekte();

// Eckdaten je Projekt für den Vergleich im Browser
const daten = await Promise.all(
  projekte.map(async (p) => ({
    slug: p.id,
    titel: p.data.titel,
    stadt: p.data.stadt,
    bild: p.data.bilder[0] ? (await getImage({ src: p.data.bilder[0].pfad, width: 480, format: 'webp' })).src : null,
    werte: Object.fromEntries(eckdaten(p).map((z) => [z.key, z.wert ?? null])),
  })),
);

// Zeilen = exakt die Eckdaten des Steckbriefs, gruppiert
const zeilen = projekte.length ? eckdaten(projekte[0]) : [];
const gruppen: EckdatenGruppe[] = ['Rahmen', 'Einordnung', 'Planung', 'Ressourcen'];
const slots = [0, 1, 2];
---

<BaseLayout
  title="Merkliste & Vergleich"
  description="Gemerkte Projekte nebeneinander vergleichen – alle Eckdaten aus dem Steckbrief auf einen Blick, per Link teilbar."
>
  <div class="container vergleich" data-vergleich-seite>
    <header class="kopf">
      <div>
        <span class="eyebrow">Merkliste</span>
        <h1>Projekte vergleichen</h1>
        <p class="lead">Bis zu drei gemerkte Projekte nebeneinander – mit allen Eckdaten aus dem Steckbrief.</p>
      </div>
      <div class="kopf__aktionen">
        <label class="nur-unterschiede">
          <input type="checkbox" data-nur-unterschiede />
          Nur Unterschiede anzeigen
        </label>
        <button type="button" class="btn btn--outline btn--small" data-link-teilen>Link teilen</button>
        <button type="button" class="btn btn--dark btn--small" data-drucken>Vergleich als PDF</button>
      </div>
    </header>
    <p class="status" role="status" aria-live="polite" data-status></p>

    <div class="tabelle-wrap">
      <table class="tabelle" data-tabelle>
        <caption class="visually-hidden">Vergleich der ausgewählten Projekte nach Eckdaten</caption>
        <thead>
          <tr>
            <td class="tabelle__ecke"></td>
            {
              slots.map((i) => (
                <th scope="col" class="slot" data-slot={i}>
                  <div class="slot__projekt" data-slot-projekt hidden>
                    <div class="slot__bild">
                      <img alt="" data-slot-bild />
                      <button type="button" class="slot__entfernen" data-slot-entfernen>
                        <span aria-hidden="true">×</span>
                        <span class="visually-hidden" data-slot-entfernen-label>Aus dem Vergleich entfernen</span>
                      </button>
                    </div>
                    <div class="slot__text">
                      <span class="slot__stadt" data-slot-stadt />
                      <span class="slot__titel" data-slot-titel />
                      <a class="link-arrow slot__link" data-slot-link href="">
                        Steckbrief öffnen →
                      </a>
                    </div>
                  </div>
                  <div class="slot__leer" data-slot-leer>
                    <span class="slot__plus" aria-hidden="true">+</span>
                    <span class="slot__leer-titel">Projekt hinzufügen</span>
                    <span class="slot__leer-text">
                      aus der <a href="#merkliste">Merkliste</a> oder dem <a href={url('entdecken/')}>Projektpool</a>
                    </span>
                  </div>
                </th>
              ))
            }
          </tr>
        </thead>
        {
          gruppen.map((g) => (
            <tbody data-gruppe={g}>
              <tr class="gruppe">
                <th scope="colgroup" colspan="4">
                  {g}
                </th>
              </tr>
              {zeilen
                .filter((z) => z.gruppe === g)
                .map((z) => (
                  <tr class="zeile" data-zeile={z.key}>
                    <th scope="row" class="zeile__label">
                      <span>
                        {z.label}
                        {z.begriff && <InfoTip begriff={z.begriff} label={z.label} />}
                      </span>
                      <span class="visually-hidden" data-diff-hinweis />
                    </th>
                    {slots.map((i) => (
                      <td data-zelle={i}>–</td>
                    ))}
                  </tr>
                ))}
            </tbody>
          ))
        }
      </table>
    </div>
    <p class="legende">
      <span class="legende__balken" aria-hidden="true"></span> Markierte Zeilen: Hier unterscheiden sich die Projekte.
    </p>

    <section class="merkliste" id="merkliste" aria-labelledby="merkliste-titel">
      <h2 id="merkliste-titel" class="merkliste__titel">Ihre Merkliste</h2>
      <p class="merkliste__hinweis">
        Die Merkliste wird nur in diesem Browser gespeichert – ohne Konto und ohne Cookies. Wählen Sie bis zu drei Projekte zum
        Vergleichen aus.
      </p>
      <ul class="merkliste__grid" data-merkliste-grid>
        {
          projekte.map((p) => (
            <li data-merk-item={p.id} hidden>
              <ProjectCard projekt={p} vergleichen />
            </li>
          ))
        }
      </ul>
      <div class="merkliste__leer" data-merkliste-leer hidden>
        <p>Sie haben noch keine Projekte gemerkt.</p>
        <a class="btn btn--dark" href={url('entdecken/')}>Projekte entdecken</a>
      </div>
    </section>

    <script type="application/json" data-vergleich-daten set:html={alsJson(daten)} />
  </div>
</BaseLayout>

<script>
  import { getMerkliste, onMerklisteChange } from '../../lib/merkliste';
  import { getVergleich, MAX_VERGLEICH, onVergleichChange, setVergleich } from '../../lib/vergleich';

  interface VergleichProjekt {
    slug: string;
    titel: string;
    stadt: string;
    bild: string | null;
    werte: Record<string, string | null>;
  }

  const root = document.querySelector<HTMLElement>('[data-vergleich-seite]')!;
  const daten: VergleichProjekt[] = JSON.parse(root.querySelector('[data-vergleich-daten]')!.textContent || '[]');
  const bySlug = new Map(daten.map((p) => [p.slug, p]));
  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  const status = root.querySelector<HTMLElement>('[data-status]')!;
  const nurUnterschiede = root.querySelector<HTMLInputElement>('[data-nur-unterschiede]')!;
  const AMPEL: Record<string, string> = { hoch: '--effort-hoch', mittel: '--effort-mittel', gering: '--effort-gering' };

  // Geteilter Link (?p=a,b,c) hat Vorrang und wird als Auswahl übernommen
  const ausUrl = new URLSearchParams(location.search).get('p');
  if (ausUrl !== null) {
    setVergleich(ausUrl.split(',').filter((s) => bySlug.has(s)).slice(0, MAX_VERGLEICH));
  }

  const escapeHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  function zelleHtml(key: string, wert: string | null): string {
    if (!wert) return '<span class="placeholder">[keine Angabe]</span>';
    if (key === 'personeller_aufwand') {
      const label = wert.charAt(0).toUpperCase() + wert.slice(1);
      return `<span class="ampel-zelle"><span class="ampel-zelle__dot" style="background:var(${AMPEL[wert]})" aria-hidden="true"></span>${label}</span>`;
    }
    return escapeHtml(wert);
  }

  function render() {
    const slugs = getVergleich().filter((s) => bySlug.has(s));
    const auswahl = slugs.map((s) => bySlug.get(s)!);

    // Kopf: Projektspalten
    root.querySelectorAll<HTMLElement>('[data-slot]').forEach((th, i) => {
      const p = auswahl[i];
      th.querySelector<HTMLElement>('[data-slot-projekt]')!.hidden = !p;
      th.querySelector<HTMLElement>('[data-slot-leer]')!.hidden = !!p;
      if (!p) return;
      const img = th.querySelector<HTMLImageElement>('[data-slot-bild]')!;
      if (p.bild) img.src = p.bild;
      img.hidden = !p.bild;
      th.querySelector('[data-slot-stadt]')!.textContent = p.stadt;
      th.querySelector('[data-slot-titel]')!.textContent = p.titel;
      th.querySelector<HTMLAnchorElement>('[data-slot-link]')!.href = `${base}projekte/${p.slug}/`;
      th.querySelector('[data-slot-entfernen-label]')!.textContent = `${p.titel} aus dem Vergleich entfernen`;
      th.querySelector<HTMLButtonElement>('[data-slot-entfernen]')!.dataset.slug = p.slug;
    });

    // Zeilen: Werte und Unterschiede
    root.querySelectorAll<HTMLTableRowElement>('[data-zeile]').forEach((tr) => {
      const key = tr.dataset.zeile!;
      const werte = auswahl.map((p) => p.werte[key]);
      tr.querySelectorAll<HTMLElement>('[data-zelle]').forEach((td, i) => {
        td.innerHTML = i < auswahl.length ? zelleHtml(key, werte[i]) : '–';
        td.classList.toggle('is-leer', i >= auswahl.length);
      });
      const diff = auswahl.length > 1 && new Set(werte.map((w) => w ?? '')).size > 1;
      tr.classList.toggle('is-diff', diff);
      tr.querySelector('[data-diff-hinweis]')!.textContent = diff ? ' (unterschiedlich)' : '';
      tr.hidden = nurUnterschiede.checked && auswahl.length > 1 && !diff;
    });
    root.querySelectorAll<HTMLElement>('[data-gruppe]').forEach((tb) => {
      tb.hidden = [...tb.querySelectorAll<HTMLElement>('[data-zeile]')].every((tr) => tr.hidden);
    });

    // URL aktualisieren (teilbar)
    const qs = slugs.length ? `?p=${slugs.join(',')}` : '';
    history.replaceState(null, '', `${location.pathname}${qs}${location.hash}`);

    // Merkliste
    const merk = getMerkliste();
    let n = 0;
    root.querySelectorAll<HTMLElement>('[data-merk-item]').forEach((li) => {
      li.hidden = !merk.includes(li.dataset.merkItem!);
      if (!li.hidden) n++;
    });
    root.querySelector<HTMLElement>('[data-merkliste-leer]')!.hidden = n > 0;
  }

  root.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('[data-slot-entfernen]');
    if (btn?.dataset.slug) {
      setVergleich(getVergleich().filter((s) => s !== btn.dataset.slug));
      status.textContent = 'Projekt aus dem Vergleich entfernt.';
    }
  });
  nurUnterschiede.addEventListener('change', render);
  root.querySelector('[data-drucken]')!.addEventListener('click', () => window.print());
  root.querySelector('[data-link-teilen]')!.addEventListener('click', async () => {
    try {
      if (navigator.share) {
        await navigator.share({ title: document.title, url: location.href });
        return;
      }
      await navigator.clipboard.writeText(location.href);
      status.textContent = 'Link zum Vergleich kopiert.';
    } catch {
      status.textContent = `Link zum Kopieren: ${location.href}`;
    }
  });
  onVergleichChange(render);
  onMerklisteChange(render);
  render();
</script>

<style>
  .vergleich {
    padding-block: var(--space-7) var(--section-gap);
  }
  .kopf {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
  }
  .kopf h1 {
    font-size: var(--text-3xl);
  }
  .kopf .lead {
    margin: 0;
  }
  .kopf__aktionen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .nur-unterschiede {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    cursor: pointer;
  }
  .nur-unterschiede input {
    width: 1.15rem;
    height: 1.15rem;
    accent-color: var(--accent);
  }
  .status {
    min-height: 1.5em;
    margin: var(--space-3) 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .tabelle {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .tabelle__ecke {
    width: 22%;
  }
  .slot {
    padding: 0 var(--space-2) var(--space-6);
    vertical-align: top;
    text-align: left;
    font-weight: 400;
  }
  .slot__projekt {
    background: var(--surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .slot__bild {
    position: relative;
    aspect-ratio: 16 / 8;
    background: var(--sand);
  }
  .slot__bild img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .slot__entfernen {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 50%;
    background: var(--surface);
    font-size: 1.2rem;
    box-shadow: var(--shadow-card);
  }
  .slot__text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: var(--space-4);
  }
  .slot__stadt {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .slot__titel {
    font-weight: 600;
    line-height: 1.3;
    hyphens: auto;
    overflow-wrap: break-word;
  }
  .zeile td {
    hyphens: auto;
    overflow-wrap: break-word;
  }
  .slot__link {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
  }
  .slot__leer {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    min-height: 13rem;
    padding: var(--space-4);
    border: 2px dashed var(--line);
    border-radius: var(--radius-lg);
    text-align: center;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .slot__plus {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--space-2);
    border-radius: 50%;
    background: var(--sand);
    color: var(--ink);
    font-size: 1.4rem;
  }
  .slot__leer-titel {
    color: var(--ink);
    font-weight: 600;
  }
  .slot__leer a {
    color: inherit;
  }

  .gruppe th {
    padding: var(--space-6) 0 var(--space-2);
    border-bottom: 1px solid var(--line);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-align: left;
    text-transform: uppercase;
  }
  .zeile th,
  .zeile td {
    padding: var(--space-3) var(--space-2);
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    text-align: left;
  }
  .zeile__label {
    position: relative;
    padding-left: var(--space-4) !important;
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 400;
  }
  .zeile.is-diff .zeile__label::before {
    content: '';
    position: absolute;
    left: 0;
    top: var(--space-3);
    bottom: var(--space-3);
    width: 4px;
    border-radius: var(--radius-full);
    background: var(--accent);
  }
  .zeile td {
    font-weight: 600;
  }
  .zeile td.is-leer {
    color: var(--muted);
    font-weight: 400;
  }
  .zeile td :global(.placeholder) {
    font-weight: 400;
  }
  .zeile td :global(.ampel-zelle) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .zeile td :global(.ampel-zelle__dot) {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
  }
  .legende {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .legende__balken {
    width: 4px;
    height: 1.1rem;
    border-radius: var(--radius-full);
    background: var(--accent);
  }

  .merkliste {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .merkliste__titel {
    font-size: var(--text-2xl);
  }
  .merkliste__hinweis {
    color: var(--muted);
    max-width: 60ch;
  }
  .merkliste__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-5);
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }
  .merkliste__leer {
    padding: var(--space-6);
    background: var(--surface);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  /* Schmale Bildschirme: Tabelle seitlich scrollbar, Beschriftung bleibt stehen */
  @media (max-width: 760px) {
    .tabelle-wrap {
      overflow-x: auto;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
    }
    .tabelle {
      min-width: 38rem;
    }
    .tabelle__ecke {
      width: 8.5rem;
    }
    .slot__text {
      padding: var(--space-3);
    }
    .zeile__label {
      position: sticky;
      left: 0;
      z-index: 1;
      background: var(--paper);
    }
  }

  @media print {
    .kopf__aktionen,
    .slot__entfernen,
    .slot__link,
    .slot__leer,
    .merkliste,
    .status {
      display: none !important;
    }
    .tabelle {
      min-width: 0;
    }
  }
</style>
